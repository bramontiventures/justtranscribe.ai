[
	{
		"name": "fileName",
		"type": "filename",
		"label": "File name",
		"required": true,
		"semantic": "file:name",
		"help": "Audio: MP3, WAV, M4A, AAC, OGG, OPUS, FLAC. Video: MP4, MOV, WEBM, MKV. Up to 500 MB and 150 minutes."
	},
	{
		"name": "data",
		"type": "buffer",
		"label": "File data",
		"required": true,
		"semantic": "file:data"
	},
	{
		"name": "wait",
		"type": "boolean",
		"label": "Wait for the transcript",
		"required": true,
		"default": false,
		"help": "Keep the module running until the transcript is ready. Make stops any module after 40 seconds, and part of that is spent uploading the file, so this only finishes in time for short recordings such as a voice note. For anything longer, leave this off and use the **Watch Completed Transcripts** trigger or the webhook below — the module still returns the transcript ID and status straight away."
	},
	{
		"name": "webhookUrl",
		"type": "url",
		"label": "Webhook URL",
		"required": false,
		"advanced": true,
		"help": "Optional. JustTranscribe sends one HTTPS POST here when this transcript finishes or fails. Paste the URL generated by the **Watch Transcript Events** instant trigger to get the result without polling."
	}
]
