[
	{
		"name": "status",
		"type": "select",
		"label": "Status",
		"required": true,
		"default": "any",
		"options": [
			{
				"label": "Any status",
				"value": "any"
			},
			{
				"label": "Complete",
				"value": "complete"
			},
			{
				"label": "Failed",
				"value": "failed"
			},
			{
				"label": "Still processing",
				"value": "pending"
			},
			{
				"label": "Waiting for capacity",
				"value": "queued"
			}
		]
	},
	{
		"name": "includeText",
		"type": "boolean",
		"label": "Include the transcript text",
		"required": true,
		"default": false,
		"help": "Adds the full text of every finished transcript to the results. Leave it off when you only need titles and IDs — the responses are much smaller."
	},
	{
		"name": "limit",
		"type": "uinteger",
		"label": "Limit",
		"required": true,
		"default": 10,
		"help": "Maximum number of transcripts Make will return during one execution cycle."
	}
]
