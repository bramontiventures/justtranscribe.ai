[
	{
		"name": "url",
		"type": "url",
		"label": "Media URL",
		"required": true,
		"help": "A public link to a video or audio: YouTube, TikTok, Instagram, Facebook, Pinterest, or a shared Google Drive file. Private and login-only links cannot be fetched."
	},
	{
		"name": "wait",
		"type": "boolean",
		"label": "Wait for the transcript",
		"required": true,
		"default": false,
		"help": "Keep the module running until the transcript is ready. Make stops any module after 40 seconds, so this only finishes in time for short recordings (roughly a couple of minutes of audio). For anything longer, leave this off and use the **Watch Completed Transcripts** trigger or the webhook below — the module still returns the transcript ID and status straight away."
	},
	{
		"name": "webhookUrl",
		"type": "url",
		"label": "Webhook URL",
		"required": false,
		"advanced": true,
		"help": "Optional. JustTranscribe sends one HTTPS POST here when this transcript finishes or fails. Paste the URL generated by the **Watch Transcript Events** instant trigger to get the result without polling."
	}
]
